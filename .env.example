# Copy to .env.local. Use the Supabase project URL and publishable key.
# Do not use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Webflow App (Data Client), configured with sites:read, cms:read and cms:write.
# Server-only variables. Register this exact callback URL in Webflow.
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/api/connectors/webflow/callback
# A stable, random 32-byte key encoded as 64 hex characters. See docs/webflow.md.
WEBFLOW_TOKEN_ENCRYPTION_KEY=
# Designer extension API: exact allowed origins, separated by commas.
DESIGNER_ALLOWED_ORIGINS=http://localhost:1337,https://webflow-ext.com
# Extension build only: set this in the terminal before building for production.
# DESIGNER_DASHBOARD_URL=https://your-dashboard.example.com

# Server-only: used exclusively by npm run worker. Never prefix with NEXT_PUBLIC_.
# Use a private Supabase service_role/server secret for this same project.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function only: set through Edge Functions Secrets, not NEXT_PUBLIC_.
# Use the same value as cms_worker_cron_secret in Supabase Vault (64 lowercase hex chars).
# CMS_WORKER_CRON_SECRET=
