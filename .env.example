# Copy to .env.local. Use the Supabase project URL and publishable key.
# Do not use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Webflow App (Data Client), configured with sites:read and cms:read only.
# Server-only variables. Register this exact callback URL in Webflow.
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/api/connectors/webflow/callback
# A stable, random 32-byte key encoded as 64 hex characters. See docs/webflow.md.
WEBFLOW_TOKEN_ENCRYPTION_KEY=
